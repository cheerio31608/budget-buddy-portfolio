# Copy to .env; fill in a local-only password before starting Compose.
DB_NAME=budget_buddy_portfolio
DB_USERNAME=budget_buddy
DB_PASSWORD=
# Avoid conflicts with an existing PostgreSQL installation on 5432.
DB_PORT=5433
APP_PORT=8080
# Optional. Leave blank to use all non-AI features.
GEMINI_API_KEY=
# Backend only. Blank JWT_SECRET uses a temporary random key in local/compose, not prod.
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=30
AI_COOLDOWN_SECONDS=60
